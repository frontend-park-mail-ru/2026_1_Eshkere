<section class="auth-page">
  <div class="auth-card">
    <h1 class="auth-card__title">Вход</h1>

    <form class="auth-form" id="login-form">
      {{{loginField}}}
      {{{passwordField}}}
      <div class="auth-form__password-actions">
        <a class="auth-form__forgot-link" href="/forgot-password">Забыли пароль?</a>
      </div>

      <div class="auth-form-not-input">
        {{{submitButton}}}
        {{{registerLinkButton}}}

        <div class="auth-divider">
          <span>или</span>
        </div>

        {{{vkLoginButton}}}
        {{{yandexLoginButton}}}
      </div>
    </form>
  </div>
</section>
