<section class='auth-page forgot-password-page'>
  <div class='auth-card auth-card--compact'>
    <div class='forgot-password-panel' data-forgot-password-flow>
      <section data-reset-step='request'>
        <h1 class='auth-card__title auth-card__title--small'>Восстановление пароля</h1>
        <p class='auth-card__description forgot-password-panel__description'>
          Введите email или телефон аккаунта. Если аккаунт существует, мы отправим код восстановления на почту.
        </p>

        <form class='auth-form' id='forgot-password-request-form'>
          {{{identifierField}}}

          <p class='forgot-password-panel__feedback' data-reset-request-feedback role='alert' hidden></p>

          <div class='auth-form-not-input auth-form-not-input--compact'>
            {{{requestButton}}}
            {{{backButton}}}
          </div>
        </form>
      </section>

      <section data-reset-step='code' hidden>
        <h1 class='auth-card__title auth-card__title--small'>Введите код из письма</h1>
        <p class='auth-card__description forgot-password-panel__description'>
          Код отправлен для аккаунта <strong data-reset-identifier></strong>.
        </p>

        <form class='auth-form' id='forgot-password-confirm-form'>
          {{{codeField}}}
          {{{newPasswordField}}}
          {{{repeatPasswordField}}}

          <p class='forgot-password-panel__feedback' data-reset-confirm-feedback role='alert' hidden></p>

          <div class='auth-form-not-input auth-form-not-input--compact'>
            {{{confirmButton}}}
            <button class='ui-button ui-button--secondary' type='button' data-reset-resend>
              Отправить код ещё раз
            </button>
            <button class='forgot-password-panel__link-button' type='button' data-reset-back>
              Изменить email или телефон
            </button>
          </div>
        </form>
      </section>

      <section class='forgot-password-success' data-reset-step='success' hidden>
        <h2 class='forgot-password-success__title' data-reset-success-title tabindex='-1'>
          Пароль успешно изменён
        </h2>
        <p class='forgot-password-success__text'>
          Теперь можно войти в рекламный кабинет с новым паролем.
        </p>
        {{{loginButton}}}
      </section>
    </div>
  </div>
</section>
