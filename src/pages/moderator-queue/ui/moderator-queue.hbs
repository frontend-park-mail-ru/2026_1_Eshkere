<section class="mq">
  <header class="mq__head">
    <div class="mq__head-title">
      <h1 class="mq__title">Очередь модерации</h1>
      {{#if stats.total}}<span class="mq__badge">{{stats.total}}</span>{{/if}}
    </div>
    <div class="mq__search">{{{searchField}}}</div>
  </header>

  {{#if loadError}}
    <p class="mq__error">{{loadError}}</p>
  {{/if}}

  <div class="mq__list">
    <div class="mq__list-header">
      <div>Объявление</div>
      <div>Описание</div>
      <div>Домен</div>
      <div>Статус</div>
      <div>Управление</div>
    </div>

    <div class="mq__list-body">
      {{#each items}}
        <article
          class="mq-item"
          data-searchable="{{searchText}}"
        >
          <div class="mq-item__title-cell">
            <a
              class="mq-item__title"
              href="{{caseUrl}}"
              data-open-moderation-case="{{id}}"
            >{{title}}</a>
          </div>
          <div class="mq-item__desc">{{desc}}</div>
          <div class="mq-item__domain">{{#if domain}}{{domain}}{{else}}—{{/if}}</div>
          <div>
            <span class="mq-item__status mq-item__status--{{statusTone}}">{{statusLabel}}</span>
          </div>
          <div class="mq-item__cta-wrap" data-open-moderation-case="{{id}}">{{{openButton}}}</div>
        </article>
      {{/each}}
    </div>

    <div class="mq__list-footer" data-moderator-queue-pagination hidden>
      <button
        class="mq__page-nav mq__page-nav--prev"
        type="button"
        data-mq-page-prev
      >
        ← Предыдущее
      </button>

      <div class="mq__page-list" data-mq-page-list></div>

      <button
        class="mq__page-nav mq__page-nav--next"
        type="button"
        data-mq-page-next
      >
        Следующее →
      </button>
    </div>
  </div>

  <p class="mq__empty" data-moderator-queue-empty hidden>Очередь пуста — нечего модерировать.</p>
</section>
