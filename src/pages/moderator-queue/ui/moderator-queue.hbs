<section class="mq">
  <header class="mq__head">
    <h1 class="mq__title">Очередь модерации</h1>
    {{#if stats.total}}<span class="mq__badge">{{stats.total}}</span>{{/if}}
    <input
      class="mq__search"
      type="search"
      placeholder="Поиск..."
      data-moderator-queue-search
      autocomplete="off"
    />
  </header>

  {{#if loadError}}
    <p class="mq__error">{{loadError}}</p>
  {{/if}}

  <div class="mq__list">
    {{#each items}}
      <article
        class="mq-item"
        data-open-moderation-case="{{id}}"
        data-searchable="{{searchText}}"
        tabindex="0"
      >
        <div class="mq-item__thumb">
          {{#if imageUrl}}<img src="{{imageUrl}}" alt="" />{{/if}}
        </div>
        <div class="mq-item__body">
          <strong class="mq-item__title">{{title}}</strong>
          <p class="mq-item__desc">{{desc}}</p>
          {{#if domain}}<span class="mq-item__domain">{{domain}}</span>{{/if}}
        </div>
        <button class="mq-item__cta" type="button" tabindex="-1">Открыть →</button>
      </article>
    {{/each}}
  </div>

  <p class="mq__empty" data-moderator-queue-empty hidden>Очередь пуста — нечего модерировать.</p>
</section>
