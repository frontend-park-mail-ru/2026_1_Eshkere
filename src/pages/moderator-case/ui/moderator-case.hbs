<div class="mc" data-mc data-case-can-apply="{{canApplyDecision}}">
  <a class="mc__back" href="/moderator/queue">← Назад к очереди</a>

  {{#if loadError}}
    <p class="mc__error">{{loadError}}</p>
  {{/if}}

  <div class="mc__layout">
    <section class="mc__content">
      <div class="mc__ad mc__ad--with-preview">
        <div class="mc__preview-card adc__preview-card">
          <div class="adc__preview-header">
            <span class="adc__preview-title">Предпросмотр объявления</span>
            <span class="adc__preview-badge">Лента</span>
          </div>

          <div class="adc__preview-ad adc__preview-ad--feed">
            <div class="adc__preview-image">
              {{#if detail.imageUrl}}
                <img src="{{detail.imageUrl}}" alt="{{detail.title}}" />
              {{else}}
                <span class="adc__preview-image-placeholder">
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="8.5" cy="8.5" r="1.5" fill="currentColor"/>
                    <path d="m3 15 5-5 4 4 3-3 6 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                  <span>Без изображения</span>
                </span>
              {{/if}}
            </div>
            <div class="adc__preview-body">
              <div class="adc__preview-meta">
                <span class="adc__preview-domain">{{detail.linkLabel}}</span>
                <span class="adc__preview-tag">Реклама</span>
              </div>
              <p class="adc__preview-headline">{{detail.title}}</p>
              <p class="adc__preview-desc">{{detail.description}}</p>
              <button class="adc__preview-cta" type="button">Узнать подробнее</button>
            </div>
          </div>
        </div>

        <div class="mc__ad-body mc__ad-body--compact">
          <span class="mc__ad-field-label">Целевая ссылка</span>
          {{#if detail.hasLink}}
            <a class="mc__ad-url" href="{{detail.link}}" target="_blank" rel="noreferrer noopener">↗ {{detail.link}}</a>
          {{else}}
            <span class="mc__ad-url mc__ad-url--missing">Ссылка не указана</span>
          {{/if}}
        </div>
      </div>
    </section>

    <aside class="mc__panel">
      <div class="mc__checks">
        {{#each detail.checks}}
          <div class="mc__check mc__check--{{state}}">
            <span class="mc__check-icon" aria-hidden="true"></span>
            <span>{{label}}</span>
          </div>
        {{/each}}
      </div>

      <input type="hidden" data-decision-input value="{{initialDecisionId}}" />

      <div class="mc__decisions">
        {{#each detail.decisionButtons}}
          <div data-decision-option="{{id}}">
            {{{buttonHtml}}}
          </div>
        {{/each}}
      </div>

      <label class="mc__comment-label">
        <span>Комментарий рекламодателю</span>
        <textarea
          class="mc__comment"
          rows="4"
          placeholder="Причина решения или что нужно исправить..."
          data-public-reply
        ></textarea>
      </label>

      {{{applyDecisionButton}}}

      <p class="mc__status-note" data-case-status-text></p>
    </aside>
  </div>
</div>
