<div class="mc" data-mc data-case-can-apply="{{canApplyDecision}}">
  <a class="mc__back" href="/moderator/queue">← Назад к очереди</a>

  {{#if loadError}}
    <p class="mc__error">{{loadError}}</p>
  {{/if}}

  <div class="mc__layout">
    <section class="mc__content">
      <div class="mc__ad">
        {{#if detail.imageUrl}}
          <div class="mc__image">
            <img src="{{detail.imageUrl}}" alt="{{detail.title}}" />
          </div>
        {{else}}
          <div class="mc__image mc__image--empty">
            <span>Без изображения</span>
          </div>
        {{/if}}
        <div class="mc__ad-body">
          <h1 class="mc__ad-title">{{detail.title}}</h1>
          <p class="mc__ad-desc">{{detail.description}}</p>
          {{#if detail.hasLink}}
            <a class="mc__ad-url" href="{{detail.link}}" target="_blank" rel="noreferrer noopener">↗ {{detail.linkLabel}}</a>
          {{else}}
            <span class="mc__ad-url mc__ad-url--missing">Ссылка не указана</span>
          {{/if}}
        </div>
      </div>
    </section>

    <aside class="mc__panel">
      <div class="mc__checks">
        {{#each detail.checks}}
          <div class="mc__check mc__check--{{state}}">
            <span class="mc__check-icon" aria-hidden="true"></span>
            <span>{{label}}</span>
          </div>
        {{/each}}
      </div>

      <input type="hidden" data-decision-input value="{{initialDecisionId}}" />

      <div class="mc__decisions">
        {{#each detail.decisions}}
          <button
            class="mc__decision mc__decision--{{tone}}{{#if @first}} is-active{{/if}}"
            type="button"
            data-decision-option="{{id}}"
            aria-pressed="{{#if @first}}true{{else}}false{{/if}}"
          >{{label}}</button>
        {{/each}}
      </div>

      <label class="mc__comment-label">
        <span>Комментарий рекламодателю</span>
        <textarea
          class="mc__comment"
          rows="4"
          placeholder="Причина решения или что нужно исправить..."
          data-public-reply
        ></textarea>
      </label>

      <button
        class="mc__submit"
        type="button"
        data-apply-decision
        {{#unless canApplyDecision}}disabled{{/unless}}
      >Применить решение</button>

      <p class="mc__status-note" data-case-status-text></p>
    </aside>
  </div>
</div>
