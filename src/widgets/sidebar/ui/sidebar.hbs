<aside class="sidebar">
  <div class="sidebar__section">
    {{#if isPartnerCabinet}}
    <a
      href="/partner/overview"
      class="sidebar__link {{#if isPartnerOverview}}sidebar__link--active{{/if}}"
      {{#if isPartnerOverview}}aria-current="page"{{/if}}
    >
      <img class="sidebar__icon" src="/icons/darhboard.svg" alt="" aria-hidden="true" />
      Обзор
    </a>
    <a
      href="/partner/sites"
      class="sidebar__link {{#if isAddSites}}sidebar__link--active{{/if}}"
      {{#if isAddSites}}aria-current="page"{{/if}}
    >
      <img class="sidebar__icon" src="/icons/Img_box.svg" alt="" aria-hidden="true" />
      Площадки
    </a>
    <a
      href="/partner/income"
      class="sidebar__link {{#if isPartnerIncome}}sidebar__link--active{{/if}}"
      {{#if isPartnerIncome}}aria-current="page"{{/if}}
    >
      <img class="sidebar__icon" src="/icons/Stat.svg" alt="" aria-hidden="true" />
      Доход
    </a>
    <a
      href="/partner/payouts"
      class="sidebar__link {{#if isPartnerPayouts}}sidebar__link--active{{/if}}"
      {{#if isPartnerPayouts}}aria-current="page"{{/if}}
    >
      <img class="sidebar__icon" src="/icons/wallet.svg" alt="" aria-hidden="true" />
      Выплаты
    </a>
    <a
      href="{{supportHref}}"
      class="sidebar__link {{#if isSupport}}sidebar__link--active{{/if}}"
      {{#if isSupport}}aria-current="page"{{/if}}
    >
      <img class="sidebar__icon" src="/icons/Question.svg" alt="" aria-hidden="true" />
      Поддержка
    </a>
    {{else}}
    <a
      href="/advertiser/overview"
      class="sidebar__link {{#if isOverview}}sidebar__link--active{{/if}}"
      {{#if isOverview}}aria-current="page"{{/if}}
      data-tour="sidebar-overview"
    >
      <img class="sidebar__icon" src="/icons/darhboard.svg" alt="" aria-hidden="true" />
      Обзор
    </a>
    <a
      href="/advertiser/campaigns"
      class="sidebar__link {{#if isCampaigns}}sidebar__link--active{{/if}}"
      {{#if isCampaigns}}aria-current="page"{{/if}}
      data-tour="sidebar-campaigns"
    >
      <img class="sidebar__icon" src="/icons/statistics.svg" alt="" aria-hidden="true" />
      Кампании
    </a>
    <a
      href="/advertiser/balance"
      class="sidebar__link {{#if isBalance}}sidebar__link--active{{/if}}"
      {{#if isBalance}}aria-current="page"{{/if}}
      data-tour="sidebar-balance"
    >
      <img class="sidebar__icon" src="/icons/wallet.svg" alt="" aria-hidden="true" />
      Баланс
    </a>
    <a
      href="{{supportHref}}"
      class="sidebar__link {{#if isSupport}}sidebar__link--active{{/if}}"
      {{#if isSupport}}aria-current="page"{{/if}}
      data-tour="sidebar-support"
    >
      <img class="sidebar__icon" src="/icons/Question.svg" alt="" aria-hidden="true" />
      Поддержка
    </a>
    {{#if showModeratorLink}}
    <a
      href="/moderator/queue"
      class="sidebar__link"
      data-tour="sidebar-moderator"
    >
      <img class="sidebar__icon" src="/icons/Chield_check.svg" alt="" aria-hidden="true" />
      Модерация
    </a>
    {{/if}}
    {{/if}}
  </div>

  <div class="sidebar__footer">
    <button
      type="button"
      class="sidebar__link sidebar__button"
      id="logout-button"
    >
      <img class="sidebar__icon" src="/icons/Export.svg" alt="" aria-hidden="true" />
      Выйти
    </button>
  </div>

  <nav class="mobile-tabbar" aria-label="Мобильная навигация кабинета">
    {{#if isPartnerCabinet}}
    <a
      href="/partner/overview"
      class="mobile-tabbar__item {{#if isPartnerOverview}}mobile-tabbar__item--active{{/if}}"
      {{#if isPartnerOverview}}aria-current="page"{{/if}}
    >
      <img class="mobile-tabbar__icon" src="/icons/darhboard.svg" alt="" aria-hidden="true" />
      <span>Обзор</span>
    </a>

    <a
      href="/partner/sites"
      class="mobile-tabbar__item {{#if isAddSites}}mobile-tabbar__item--active{{/if}}"
      {{#if isAddSites}}aria-current="page"{{/if}}
    >
      <img class="mobile-tabbar__icon" src="/icons/Img_box.svg" alt="" aria-hidden="true" />
      <span>Площадки</span>
    </a>

    <a
      href="/partner/income"
      class="mobile-tabbar__item {{#if isPartnerIncome}}mobile-tabbar__item--active{{/if}}"
      {{#if isPartnerIncome}}aria-current="page"{{/if}}
    >
      <img class="mobile-tabbar__icon" src="/icons/Stat.svg" alt="" aria-hidden="true" />
      <span>Доход</span>
    </a>

    <a
      href="/partner/payouts"
      class="mobile-tabbar__item {{#if isPartnerPayouts}}mobile-tabbar__item--active{{/if}}"
      {{#if isPartnerPayouts}}aria-current="page"{{/if}}
    >
      <img class="mobile-tabbar__icon" src="/icons/wallet.svg" alt="" aria-hidden="true" />
      <span>Выплаты</span>
    </a>

    <details class="mobile-tabbar__more">
      <summary class="mobile-tabbar__item mobile-tabbar__item--more">
        <img class="mobile-tabbar__icon" src="/icons/Menu.svg" alt="" aria-hidden="true" />
        <span>Еще</span>
      </summary>

      <div class="mobile-tabbar__sheet">
        <span class="mobile-tabbar__sheet-title">Еще разделы</span>
        <a
          class="mobile-tabbar__sheet-item {{#if isSupport}}mobile-tabbar__sheet-item--active{{/if}}"
          href="{{supportHref}}"
          {{#if isSupport}}aria-current="page"{{/if}}
        >
          <img class="mobile-tabbar__sheet-icon" src="/icons/Question.svg" alt="" aria-hidden="true" />
          Поддержка
        </a>
        {{#if showModeratorLink}}
        <a
          class="mobile-tabbar__sheet-item"
          href="/moderator/queue"
        >
          <img class="mobile-tabbar__sheet-icon" src="/icons/Chield_check.svg" alt="" aria-hidden="true" />
          Модерация
        </a>
        {{/if}}
      </div>
    </details>
    {{else}}
    <a
      href="/advertiser/overview"
      class="mobile-tabbar__item {{#if isOverview}}mobile-tabbar__item--active{{/if}}"
      {{#if isOverview}}aria-current="page"{{/if}}
    >
      <img class="mobile-tabbar__icon" src="/icons/darhboard.svg" alt="" aria-hidden="true" />
      <span>Обзор</span>
    </a>

    <a
      href="/advertiser/campaigns"
      class="mobile-tabbar__item {{#if isCampaigns}}mobile-tabbar__item--active{{/if}}"
      {{#if isCampaigns}}aria-current="page"{{/if}}
    >
      <img class="mobile-tabbar__icon" src="/icons/statistics.svg" alt="" aria-hidden="true" />
      <span>Кампании</span>
    </a>

    <a
      href="/advertiser/balance"
      class="mobile-tabbar__item {{#if isBalance}}mobile-tabbar__item--active{{/if}}"
      {{#if isBalance}}aria-current="page"{{/if}}
    >
      <img class="mobile-tabbar__icon" src="/icons/wallet.svg" alt="" aria-hidden="true" />
      <span>Баланс</span>
    </a>

    <details class="mobile-tabbar__more">
      <summary class="mobile-tabbar__item mobile-tabbar__item--more">
        <img class="mobile-tabbar__icon" src="/icons/Menu.svg" alt="" aria-hidden="true" />
        <span>Еще</span>
      </summary>

      <div class="mobile-tabbar__sheet">
        <span class="mobile-tabbar__sheet-title">Еще разделы</span>
        <a
          class="mobile-tabbar__sheet-item {{#if isSupport}}mobile-tabbar__sheet-item--active{{/if}}"
          href="{{supportHref}}"
          {{#if isSupport}}aria-current="page"{{/if}}
        >
          <img class="mobile-tabbar__sheet-icon" src="/icons/Question.svg" alt="" aria-hidden="true" />
          Поддержка
        </a>
        {{#if showModeratorLink}}
        <a
          class="mobile-tabbar__sheet-item"
          href="/moderator/queue"
        >
          <img class="mobile-tabbar__sheet-icon" src="/icons/Chield_check.svg" alt="" aria-hidden="true" />
          Модерация
        </a>
        {{/if}}
      </div>
    </details>
    {{/if}}
  </nav>
</aside>
