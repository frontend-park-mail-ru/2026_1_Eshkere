<header class="navbar">
  <div class="navbar__left">
    <a href="/" class="navbar__brand">
      <img
        src="/img/logo.webp"
        alt="Логотип ЭшкеРеклама"
        class="navbar__logo"
        width="42"
        height="42"
      />

      <div class="navbar__brand-text">
        <span class="navbar__title">ЭшкеРеклама</span>
        <span class="navbar__subtitle">by Эшкере.</span>
      </div>
    </a>

  </div>

  <div class="navbar__actions">
    <button
      class="navbar__theme-btn"
      id="navbar-theme-btn"
      type="button"
      aria-label="Переключить тему оформления"
    >
      <span class="navbar__theme-btn-track" aria-hidden="true">
        <span class="navbar__theme-btn-thumb"></span>
      </span>
    </button>

    {{#if isAuthenticated}}
      <div class="navbar__actions-user">
        {{#if cabinet.showAdvertiserWallet}}
        <div class="navbar__balance">{{user.balanceLabel}}</div>

        <a
          class="navbar__actions-user-icon navbar__actions-user-icon--wallet"
          href="/advertiser/balance"
          aria-label="Перейти к балансу"
        >
          <span
            class="navbar__actions-user-glyph navbar__actions-user-glyph--wallet"
            aria-hidden="true"
          ></span>
        </a>
        {{/if}}

        <button
          class="navbar__actions-user-icon navbar__actions-user-icon--notification"
          type="button"
          id="navbar-notifications-toggle"
          aria-expanded="false"
          aria-controls="navbar-notifications-menu"
          aria-label="Открыть уведомления"
        >
          <span
            class="navbar__actions-user-glyph navbar__actions-user-glyph--notification"
            aria-hidden="true"
          ></span>
        </button>

        <div class="navbar__notifications-menu" id="navbar-notifications-menu" hidden>
          <div class="navbar__notifications-head">
            <div class="navbar__notifications-copy">
              <span class="navbar__notifications-kicker">Уведомления</span>
              <strong class="navbar__notifications-title">Последние события кабинета</strong>
            </div>
            <div class="navbar__notifications-head-actions">
              <span class="navbar__notifications-badge">{{notifications.length}}</span>
              <button
                class="navbar__notifications-settings-btn"
                type="button"
                id="navbar-notifications-settings-open"
                aria-label="Настройки уведомлений"
                title="Настройки уведомлений"
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M19.14 12.94c.04-.3.06-.61.06-.94s-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96a7.02 7.02 0 0 0-1.62-.94l-.36-2.54a.484.484 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96a.48.48 0 0 0-.59.22L2.74 8.87a.47.47 0 0 0 .12.61l2.03 1.58c-.05.3-.07.62-.07.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.37 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.57 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32a.47.47 0 0 0-.12-.61l-2.01-1.58ZM12 15.6a3.6 3.6 0 1 1 0-7.2 3.6 3.6 0 0 1 0 7.2Z"/>
                </svg>
              </button>
            </div>
          </div>

          <div class="navbar__notifications-list">
            {{#each notifications}}
              <article
                class="navbar__notification-card navbar__notification-card--{{tone}}"
                data-notification-item
                data-notification-id="{{@index}}"
              >
                <span class="navbar__notification-dot" aria-hidden="true"></span>
                <div class="navbar__notification-content">
                  <div class="navbar__notification-row">
                    <strong class="navbar__notification-title">{{title}}</strong>
                    <button
                      class="navbar__notification-dismiss"
                      type="button"
                      aria-label="Скрыть уведомление"
                      data-notification-dismiss
                    >
                      ×
                    </button>
                  </div>
                  <p class="navbar__notification-text">{{text}}</p>
                  <span class="navbar__notification-time">{{time}}</span>
                </div>
              </article>
            {{/each}}
          </div>

          <div class="navbar__notifications-footer">
            <button
              class="navbar__notifications-all"
              type="button"
              id="navbar-notifications-all"
            >
              Показать все
            </button>
          </div>
        </div>

        <div class="navbar__avatar{{#if user.hasAvatar}} navbar__avatar--image{{/if}}" aria-label="{{user.name}}">
          {{#if user.hasAvatar}}
            <img class="navbar__avatar-image" src="{{user.avatar}}" alt="{{user.name}}" />
          {{else}}
            <span class="navbar__avatar-initials">{{user.initials}}</span>
          {{/if}}
        </div>

        <button
          class="navbar__profile-toggle"
          type="button"
          id="navbar-profile-toggle"
          aria-expanded="false"
          aria-controls="navbar-profile-menu"
          aria-label="{{user.name}}"
        >
          <img src="/icons/chevron-down.svg" alt="" />
        </button>

        <div class="navbar__profile-menu" id="navbar-profile-menu" hidden>
          <a class="navbar__profile-menu-head" href="{{cabinet.profileHref}}">
            <div class="navbar__profile-menu-avatar{{#if user.hasAvatar}} navbar__profile-menu-avatar--image{{/if}}" aria-label="{{user.name}}">
              {{#if user.hasAvatar}}
                <img
                  class="navbar__profile-menu-avatar-image"
                  src="{{user.avatar}}"
                  alt="{{user.name}}"
                />
              {{else}}
                <span class="navbar__profile-menu-avatar-initials">{{user.initials}}</span>
              {{/if}}
            </div>
            <div class="navbar__profile-menu-copy">
              <span class="navbar__profile-menu-kicker">Аккаунт</span>
              <span class="navbar__profile-menu-name">{{user.name}}</span>
            </div>
            <span class="navbar__profile-menu-arrow">›</span>
          </a>

          <div class="navbar__profile-menu-body">
            <a class="navbar__profile-menu-link" href="{{cabinet.profileHref}}">
              <span
                class="navbar__profile-menu-link-icon navbar__profile-menu-link-icon--profile"
                aria-hidden="true"
              ></span>
              <span class="navbar__profile-menu-link-copy">
                <strong>Профиль</strong>
                <span>Личные данные и настройки кабинета</span>
              </span>
            </a>

            <section class="navbar__profile-cabinets" aria-label="Кабинет">
              <span class="navbar__profile-cabinets-label">Кабинет</span>
              <div class="navbar__profile-cabinets-list">
                <a
                  class="navbar__profile-cabinet {{#if cabinet.isAdvertiser}}navbar__profile-cabinet--active{{/if}}"
                  href="{{cabinet.advertiserHref}}"
                  {{#if cabinet.isAdvertiser}}aria-current="page"{{/if}}
                >
                  <strong>Рекламодатель</strong>
                  <span>Кампании и бюджет</span>
                </a>
                <a
                  class="navbar__profile-cabinet {{#if cabinet.isPartner}}navbar__profile-cabinet--active{{/if}}"
                  href="{{cabinet.partnerHref}}"
                  {{#if cabinet.isPartner}}aria-current="page"{{/if}}
                >
                  <strong>Партнер</strong>
                  <span>Площадки и выплаты</span>
                </a>
              </div>
            </section>
          </div>

          <button
            class="navbar__profile-menu-logout"
            type="button"
            id="navbar-logout-button"
          >
            Выйти
          </button>
        </div>

        <div class="navbar__logout-modal" id="navbar-logout-modal" hidden>
          <div
            class="navbar__logout-modal-dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="navbar-logout-modal-title"
          >
            <div class="navbar__logout-modal-head">
              <h3
                class="navbar__logout-modal-title"
                id="navbar-logout-modal-title"
              >
                Выход из аккаунта
              </h3>
              <p class="navbar__logout-modal-text">
                Подтвердите действие, если хотите завершить текущую сессию.
              </p>
            </div>

            <div class="navbar__logout-modal-illustration" aria-hidden="true">
              <span class="navbar__logout-modal-blob"></span>
              <img
                class="navbar__logout-modal-image"
                src="/img/Bored.webp"
                alt=""
              />
            </div>

            <div class="navbar__logout-modal-note">
              После выхода потребуется заново авторизоваться, чтобы открыть
              рекламный кабинет.
            </div>

            <div class="navbar__logout-modal-actions">
              <button
                type="button"
                class="navbar__logout-modal-button navbar__logout-modal-button--secondary"
                id="navbar-logout-cancel"
              >
                Остаться
              </button>
              <button
                type="button"
                class="navbar__logout-modal-button navbar__logout-modal-button--primary"
                id="navbar-logout-confirm"
              >
                Выйти
              </button>
            </div>
          </div>
        </div>

        <div class="navbar__notifications-settings" id="navbar-notifications-settings" hidden>
          <div
            class="navbar__notifications-settings-dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="navbar-notifications-settings-title"
          >
            <div class="navbar__notifications-settings-head">
              <div>
                <span class="navbar__notifications-kicker">Настройки</span>
                <h3 class="navbar__notifications-settings-title" id="navbar-notifications-settings-title">
                  Настройки уведомлений
                </h3>
              </div>
              <button
                class="navbar__notifications-modal-close"
                type="button"
                id="navbar-notifications-settings-close"
                aria-label="Закрыть настройки"
              >×</button>
            </div>

            <div class="navbar__notifications-settings-body">
              <div class="navbar__notif-section">
                <strong class="navbar__notif-section-title">Каналы уведомлений</strong>
                <p class="navbar__notif-section-sub">Выберите, куда отправлять оповещения о состоянии баланса</p>

                <div class="navbar__notif-channels">
                  <div class="navbar__notif-channel">
                    <div class="navbar__notif-channel-icon navbar__notif-channel-icon--bell" aria-hidden="true">
                      <img src="/icons/notification.svg" alt="" width="18" height="18" />
                    </div>
                    <div class="navbar__notif-channel-copy">
                      <strong>В кабинете</strong>
                      <span>Уведомления отображаются внутри рекламного кабинета</span>
                    </div>
                    <span class="navbar__notif-badge">Рекомендуется</span>
                    <label class="navbar__notif-toggle">
                      <input type="checkbox" data-notif-channel="inapp" checked />
                      <span class="navbar__notif-toggle-ui"></span>
                    </label>
                  </div>

                  <div class="navbar__notif-channel">
                    <div class="navbar__notif-channel-icon navbar__notif-channel-icon--email" aria-hidden="true">
                      <img src="/icons/Message.svg" alt="" width="18" height="18" />
                    </div>
                    <div class="navbar__notif-channel-copy">
                      <strong>Email</strong>
                      <span>{{user.email}}</span>
                    </div>
                    <label class="navbar__notif-toggle">
                      <input type="checkbox" data-notif-channel="email" />
                      <span class="navbar__notif-toggle-ui"></span>
                    </label>
                  </div>

                  <div class="navbar__notif-channel navbar__notif-channel--disabled">
                    <div class="navbar__notif-channel-icon navbar__notif-channel-icon--telegram" aria-hidden="true">
                      <img src="/icons/platforms/telegram.svg" alt="" width="18" height="18" />
                    </div>
                    <div class="navbar__notif-channel-copy">
                      <strong>Telegram</strong>
                      <span>Бот не подключён — нажмите для настройки</span>
                    </div>
                    <span class="navbar__notif-badge navbar__notif-badge--action">Подключить</span>
                    <label class="navbar__notif-toggle">
                      <input type="checkbox" data-notif-channel="telegram" disabled />
                      <span class="navbar__notif-toggle-ui"></span>
                    </label>
                  </div>

                  <div class="navbar__notif-channel navbar__notif-channel--disabled">
                    <div class="navbar__notif-channel-icon navbar__notif-channel-icon--sms" aria-hidden="true">
                      <img src="/icons/Chat.svg" alt="" width="18" height="18" />
                    </div>
                    <div class="navbar__notif-channel-copy">
                      <strong>SMS</strong>
                      <span>Укажите номер телефона для получения SMS</span>
                    </div>
                    <label class="navbar__notif-toggle">
                      <input type="checkbox" data-notif-channel="sms" disabled />
                      <span class="navbar__notif-toggle-ui"></span>
                    </label>
                  </div>
                </div>
              </div>

              <div class="navbar__notif-section">
                <strong class="navbar__notif-section-title">Пороги срабатывания</strong>
                <p class="navbar__notif-section-sub">Уведомление будет отправлено, когда баланс опустится до указанного порога</p>

                <div class="navbar__notif-thresholds">
                  <div class="navbar__notif-threshold navbar__notif-threshold--editable" data-threshold-key="warning">
                    <span class="navbar__notif-threshold-icon" aria-hidden="true"></span>
                    <div class="navbar__notif-threshold-field">
                      <strong class="navbar__notif-threshold-value" data-threshold-display="warning">500</strong>
                      <input class="navbar__notif-threshold-input" type="text" inputmode="numeric" maxlength="6" data-threshold-input="warning" aria-label="Порог предупреждения, ₽" hidden />
                      <span class="navbar__notif-threshold-suffix">₽</span>
                    </div>
                    <span class="navbar__notif-threshold-label">Предупреждение</span>
                    <span class="navbar__notif-threshold-hint">Нажмите для изменения</span>
                  </div>
                  <div class="navbar__notif-threshold navbar__notif-threshold--editable" data-threshold-key="critical">
                    <span class="navbar__notif-threshold-icon" aria-hidden="true"></span>
                    <div class="navbar__notif-threshold-field">
                      <strong class="navbar__notif-threshold-value" data-threshold-display="critical">100</strong>
                      <input class="navbar__notif-threshold-input" type="text" inputmode="numeric" maxlength="6" data-threshold-input="critical" aria-label="Критический порог, ₽" hidden />
                      <span class="navbar__notif-threshold-suffix">₽</span>
                    </div>
                    <span class="navbar__notif-threshold-label">Критично</span>
                    <span class="navbar__notif-threshold-hint">Нажмите для изменения</span>
                  </div>
                  <div class="navbar__notif-threshold">
                    <span class="navbar__notif-threshold-icon" aria-hidden="true"></span>
                    <div class="navbar__notif-threshold-field">
                      <strong class="navbar__notif-threshold-value">0</strong>
                      <span class="navbar__notif-threshold-suffix">₽</span>
                    </div>
                    <span class="navbar__notif-threshold-label">Баланс исчерпан</span>
                  </div>
                </div>
              </div>
            </div>
          </div>


        </div>

        <div class="navbar__notifications-modal" id="navbar-notifications-modal" hidden>
          <div
            class="navbar__notifications-modal-dialog"
            role="dialog"
            aria-modal="true"
            aria-labelledby="navbar-notifications-modal-title"
          >
            <div class="navbar__notifications-modal-head">
              <div class="navbar__notifications-copy">
                <span class="navbar__notifications-kicker">Уведомления</span>
                <h3
                  class="navbar__notifications-modal-title"
                  id="navbar-notifications-modal-title"
                >
                  Все уведомления кабинета
                </h3>
              </div>

              <button
                class="navbar__notifications-modal-close"
                type="button"
                id="navbar-notifications-close"
                aria-label="Закрыть уведомления"
              >
                ×
              </button>
            </div>

            <div class="navbar__notifications-modal-list">
              {{#each notifications}}
                <article
                  class="navbar__notification-card navbar__notification-card--{{tone}}"
                  data-notification-modal-item
                  data-notification-id="{{@index}}"
                >
                  <span class="navbar__notification-dot" aria-hidden="true"></span>
                  <div class="navbar__notification-content">
                    <div class="navbar__notification-row">
                      <strong class="navbar__notification-title">{{title}}</strong>
                      <button
                        class="navbar__notification-dismiss"
                        type="button"
                        aria-label="Скрыть уведомление"
                        data-notification-modal-dismiss
                      >
                        ×
                      </button>
                    </div>
                    <p class="navbar__notification-text">{{text}}</p>
                    <span class="navbar__notification-time">{{time}}</span>
                  </div>
                </article>
              {{/each}}
            </div>

            <div class="navbar__notifications-empty" id="navbar-notifications-empty" hidden>
              <img
                class="navbar__notifications-empty-image"
                src="/img/No%20Results.webp"
                alt=""
              />
              <strong class="navbar__notifications-empty-title">Уведомлений пока нет</strong>
              <p class="navbar__notifications-empty-text">
                Когда появятся новые события по кабинету, они отобразятся здесь.
              </p>
            </div>
          </div>
        </div>
      </div>
    {{else}}
      <a
        href="/login"
        class="navbar__button navbar__button--ghost {{#if isLogin}}is-active{{/if}}"
      >
        Вход
      </a>

      <a
        href="/register"
        class="navbar__button navbar__button--primary {{#if isRegister}}is-active{{/if}}"
      >
        Регистрация
      </a>
    {{/if}}
  </div>
</header>
